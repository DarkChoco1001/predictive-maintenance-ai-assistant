# Copy to .env and adjust. Never commit .env (it is git-ignored).
APP_ENV=production                 # "development" enables /api/docs
CORS_ORIGINS=http://localhost:5173 # comma-separated frontend origins
ALLOWED_HOSTS=localhost,127.0.0.1,backend
TRUST_PROXY_HEADERS=false          # true only behind the bundled nginx proxy
ENABLE_HSTS=false                  # true when served over HTTPS
RATE_LIMIT_ASSISTANT_PER_MIN=10
RATE_LIMIT_WRITE_PER_MIN=30

# AI assistant: none (offline rules, default) | anthropic | ollama
LLM_PROVIDER=none
# ANTHROPIC_API_KEY=sk-ant-...     # only if LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-opus-5-5
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
